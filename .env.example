# Public API origin/path only. Never put a client secret or credential here.
# Same-origin backend example:
NEXT_PUBLIC_AUTH_API_BASE_URL=/api/auth

# Demo auth is enabled in development by default.
# Set true at build time only for a public test deployment; all visitors can use
# the published dummy credentials and OTP. Never use this for real user accounts.
# Production builds otherwise disable demo auth. Set false to test the API contract.
NEXT_PUBLIC_AUTH_DEMO_MODE=true

# Cross-origin API example (serve over HTTPS and configure credentialed CORS):
# NEXT_PUBLIC_AUTH_API_BASE_URL=https://api.example.com/api/auth
